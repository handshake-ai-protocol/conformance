  },
  "_mldsa65_kat_comment": "ML-DSA-65 (FIPS 204) deterministic KAT. Each runner derives the keypair from the 32-byte seed (FIPS 204 ξ), then deterministically signs the message (FIPS 204 §5.5 with empty context). Wire-format byte-equality is verified by hashing the public key (1952 B) and signature (3309 B) — pinning the digests instead of the raw bytes keeps the fixture file small. Both digests below were originally produced by the canonical Rust core (RustCrypto `ml-dsa` 0.0.4) AND independently reproduced by the Go core (`cloudflare/circl` v1.6.1) before pinning, and have been re-verified byte-equal under the post-vuln-patch versions (`ml-dsa` 0.1.0-rc.9 and `cloudflare/circl` v1.6.3). Verifies the FIPS 204 keygen + deterministic-signing interop across implementations.",
  "mldsa65_kat": {
    "name": "handshake_mldsa65_deterministic_v1",
    "seed_hex": "2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a",
    "message_utf8": "handshake-mldsa65-kat-v1",
    "expected_public_key_sha256": "b7acce2ddb11f8cc1aa46e2bafac6eacfa2b732ef192bd636ad8d3a56d649c66",
    "expected_signature_sha256": "a8f4ba6885ee507857ccddc9eb59c4e9903c5cf666f4ed81674563546f5fdbda"
  }
