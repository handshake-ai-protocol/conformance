{
  "_comment": "Cross-implementation conformance fixtures for the Handshake protocol. JCS canonical SHA-256 must be byte-identical across all four cores. Where `expected_canonical` is present, the canonical UTF-8 string MUST match exactly — that field is the normative golden output (hand-verifiable against RFC 8785), defending against the case where all four implementations drift identically. The IEEE-754 block exercises the ECMAScript 6.1.6.1 Number→String algorithm RFC 8785 §3.2.2.3 prescribes (per RFC 8785 Appendix B). The Ed25519 KAT block is RFC 8032 §7.1 Test 1; the ML-DSA-65 KAT block is a Handshake-specific deterministic vector — see _mldsa65_kat_comment.",
  "fixtures": [
    {
      "name": "empty_object",
      "input": {},
      "expected_canonical": "{}"
    },
    {
      "name": "empty_array",
      "input": [],
      "expected_canonical": "[]"
    },
    {
      "name": "scalar_string",
      "input": "hello",
      "expected_canonical": "\"hello\""
    },
    {
      "name": "scalar_int",
      "input": 100,
      "expected_canonical": "100"
    },
    {
      "name": "scalar_negative_int",
      "input": -42,
      "expected_canonical": "-42"
    },
    {
      "name": "scalar_zero",
      "input": 0,
      "expected_canonical": "0"
    },
    {
      "name": "scalar_true",
      "input": true,
      "expected_canonical": "true"
    },
    {
      "name": "scalar_null",
      "input": null,
      "expected_canonical": "null"
    },
    {
      "name": "key_sort_two",
      "input": { "b": 2, "a": 1 },
      "expected_canonical": "{\"a\":1,\"b\":2}"
    },
    {
      "name": "key_sort_nested",
      "input": { "z": { "b": 2, "a": 1 }, "a": [3, 1, 2] },
      "expected_canonical": "{\"a\":[3,1,2],\"z\":{\"a\":1,\"b\":2}}"
    },
    {
      "name": "string_escapes",
      "input": "quote=\" back=\\ tab=\t newline=\n cr=\r ctrl=\u0001",
      "expected_canonical": "\"quote=\\\" back=\\\\ tab=\\t newline=\\n cr=\\r ctrl=\\u0001\""
    },
    {
      "name": "unicode_passthrough",
      "input": "héllo こんにちは",
      "expected_canonical": "\"héllo こんにちは\""
    },

    { "_comment_ieee754": "These fixtures pin RFC 8785 §3.2.2.3 (ECMAScript 6.1.6.1 Number→String) outputs. Sourced from RFC 8785 Appendix B and the json-canonicalization reference test corpus. Hand-verifiable: pipe each input value through Node.js `JSON.stringify(Number(x))` to reproduce." },

    { "name": "ieee754_4_50",         "input": 4.50,                                "expected_canonical": "4.5" },
    { "name": "ieee754_0_002",        "input": 0.002,                               "expected_canonical": "0.002" },
    { "name": "ieee754_1e_minus_7",   "input": 1e-7,                                "expected_canonical": "1e-7" },
    { "name": "ieee754_1e30",         "input": 1e30,                                "expected_canonical": "1e+30" },
    { "name": "ieee754_1e21",         "input": 1e21,                                "expected_canonical": "1e+21" },
    { "name": "ieee754_1e20",         "input": 1e20,                                "expected_canonical": "100000000000000000000" },
    { "name": "ieee754_neg_zero",     "input": -0.0,                                "expected_canonical": "0" },
    { "name": "ieee754_one_third",    "input": 0.333333333333333314829616256247390992939472198486328125, "expected_canonical": "0.3333333333333333" },
    { "name": "ieee754_max_safe_int", "input": 9007199254740991,                    "expected_canonical": "9007199254740991" },
    { "name": "ieee754_avogadro",     "input": 6.02214076e23,                       "expected_canonical": "6.02214076e+23" },
    { "name": "ieee754_planck",       "input": 6.62607015e-34,                      "expected_canonical": "6.62607015e-34" },

